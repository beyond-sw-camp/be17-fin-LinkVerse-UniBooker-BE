pipeline {
  agent {
    kubernetes {
      label "gradle-kaniko-${UUID.randomUUID().toString()}"
      defaultContainer 'gradle'
      yaml """
apiVersion: v1
kind: Pod
metadata:
  namespace: jenkins-ci
spec:
  serviceAccountName: jenkins
  restartPolicy: Never
  containers:
    - name: gradle
      image: gradle:8.9-jdk17
      command: ['sleep']
      args: ['infinity']
      volumeMounts:
        - name: gradle-cache
          mountPath: /home/gradle/.gradle
        - name: workspace-volume
          mountPath: /home/jenkins/agent

    - name: kaniko
      image: gcr.io/kaniko-project/executor:debug
      command: ['/busybox/sh', '-c', 'sleep infinity']
      volumeMounts:
        - name: docker-config
          mountPath: /kaniko/.docker
        - name: kaniko-cache
          mountPath: /cache
        - name: workspace-volume
          mountPath: /home/jenkins/agent

    - name: deploy
      image: ubuntu:22.04
      command: ['sleep']
      args: ['infinity']
      volumeMounts:
        - name: workspace-volume
          mountPath: /home/jenkins/agent

  volumes:
    - name: gradle-cache
      persistentVolumeClaim:
        claimName: gradle-cache-pvc
    - name: kaniko-cache
      persistentVolumeClaim:
        claimName: kaniko-cache-pvc
    - name: workspace-volume
      persistentVolumeClaim:
        claimName: workspace-pvc
    - name: docker-config
      secret:
        secretName: dockerhub-cred
        items:
          - key: .dockerconfigjson
            path: config.json
"""
    }
  }

  environment {
    SERVICE_PATH       = 'api-queue'
    IMAGE_NAME         = 'linkverseunibooker/queue'
    IMAGE_TAG          = "${env.BUILD_NUMBER}"
    DEPLOY_NAMESPACE   = 'unibooker'

    GITOPS_REPO_URL    = 'https://github.com/YOUR_ID/infra-gitops.git'
    GITOPS_REPO_DIR    = 'infra-gitops'
    GITOPS_MANIFEST    = 'unibooker/backend-queue/rollout.yaml'
  }

  stages {

    stage('Gradle Build') {
      steps {
        container('gradle') {
          sh """
            set -x
            cd ${WORKSPACE}
            chmod +x ./gradlew || true
            ./gradlew :api-queue:build -x test --no-daemon --parallel
          """
        }
      }
    }

    stage('Kaniko Build & Push') {
      steps {
        container('kaniko') {
          sh """
            cd ${WORKSPACE}/${SERVICE_PATH}

            /kaniko/executor \
              --context=${WORKSPACE}/${SERVICE_PATH} \
              --dockerfile=${WORKSPACE}/${SERVICE_PATH}/Dockerfile \
              --destination=${IMAGE_NAME}:${IMAGE_TAG} \
              --destination=${IMAGE_NAME}:latest \
              --cache=true \
              --cache-dir=/cache
          """
        }
      }
    }

    stage('Update GitOps Manifest') {
      steps {
        container('deploy') {
          withCredentials([usernamePassword(
            credentialsId: 'gitops-cred',
            usernameVariable: 'GIT_USER',
            passwordVariable: 'GIT_TOKEN'
          )]) {

            sh """
              set -x
              rm -rf ${GITOPS_REPO_DIR}
              git clone https://${GIT_USER}:${GIT_TOKEN}@github.com/YOUR_ID/infra-gitops.git

              cd ${GITOPS_REPO_DIR}

              # 이미지 부분만 업데이트
              sed -i "s#image: ${IMAGE_NAME}:.*#image: ${IMAGE_NAME}:${IMAGE_TAG}#" ${GITOPS_MANIFEST}

              git config user.email "jenkins@unibooker.com"
              git config user.name "Jenkins CI"

              git add ${GITOPS_MANIFEST}
              git commit -m "[CI] Update queue image to ${IMAGE_TAG}"
              git push
            """
          }
        }
      }
    }

    stage('Result') {
      steps {
        container('deploy') {
          sh 'echo "Queue Service Build Completed: ${IMAGE_NAME}:${IMAGE_TAG}"'
        }
      }
    }
  }
}
